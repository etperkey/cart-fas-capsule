#!/usr/bin/env bash
# Code Ocean postInstall for R 4.4.2 on Ubuntu 22.04 Jammy.
# Pulls Posit binary R packages (jammy) + Bioconductor 3.20.
#
# HTTPUserAgent is set so Posit Package Manager routes to pre-compiled
# Linux binaries rather than source tarballs (critical for build time —
# source compilation of RcppArmadillo, DESeq2, lme4, etc. is 10-30x slower).
# Bioconductor packages still come from Bioconductor's own repo (source),
# as Bioc does not provide Linux binaries the way Posit does for CRAN.
set -eo pipefail

Rscript -e 'options(repos = c(CRAN = "https://packagemanager.posit.co/cran/__linux__/jammy/latest"), HTTPUserAgent = sprintf("R/%s R (%s)", getRversion(), paste(getRversion(), R.version$platform, R.version$arch, R.version$os)), Ncpus = 4); install.packages(c("BiocManager","remotes","tidyverse","readxl","vroom","ggsci","ggpubr","ggtext","ggfortify","ggnewscale","ggrepel","circlize","survival","survminer","maxstat","rstatix","patchwork","cowplot","scales","matrixStats"))'

Rscript -e 'options(repos = c(CRAN = "https://packagemanager.posit.co/cran/__linux__/jammy/latest"), HTTPUserAgent = sprintf("R/%s R (%s)", getRversion(), paste(getRversion(), R.version$platform, R.version$arch, R.version$os)), Ncpus = 4); BiocManager::install(version = "3.20", ask = FALSE, update = FALSE); BiocManager::install(c("DESeq2","edgeR","limma","tximport","GSVA","GEOquery","AnnotationDbi","org.Hs.eg.db","GenomicFeatures","SummarizedExperiment","rtracklayer","ComplexHeatmap","vsn"), update = FALSE, ask = FALSE, Ncpus = 4)'

echo "[postInstall] Done."
